[case testIntersectionErrorSyntax]
# TODO add --python-version 3.XY hopefully sometime
# flags: --python-version 3.13 --no-force-intersection-syntax
from typing import Intersection
x : Intersection[bool, str]
x = 3 # E: Incompatible types in assignment (expression has type "int", variable has type "bool & str")

[case testIntersectionOrErrorSyntax]
# flags: --python-version 3.13 --force-intersection-syntax
from typing import Intersection
x : Intersection[bool, str]
x = 3 # E: Incompatible types in assignment (expression has type "int", variable has type "Intersection[bool, str]")

