[case testIntersectionAndSyntaxWithQuotedFunctionTypesPre310]
# flags: --python-version 3.9
from typing import Intersection
def f(x: 'Intersection[int, str, None]') -> 'Intersection[int, None]':
    reveal_type(x)  # N: Revealed type is "Intersection[builtins.int, builtins.str, None]"
    return 42
reveal_type(f)  # N: Revealed type is "def (x: Intersection[builtins.int, builtins.str, None]) -> Intersection[builtins.int, None]"

def g(x: "int & str & None") -> "int & None":
    reveal_type(x)  # N: Revealed type is "Intersection[builtins.int, builtins.str, None]"
    return 42
reveal_type(g)  # N: Revealed type is "def (x: Intersection[builtins.int, builtins.str, None]) -> Intersection[builtins.int, None]"

[case testIntersectionAndSyntaxWithQuotedVariableTypesPre310]
# flags: --python-version 3.9
y: "int & str" = 42
reveal_type(y)  # N: Revealed type is "Intersection[builtins.int, builtins.str]"

[case testIntersectionAndSyntaxWithTypeAliasWorking]
# flags: --python-version 3.13
T = int & str
x: T
reveal_type(x)  # N: Revealed type is "Intersection[builtins.int, builtins.str]"
S = list[int] & str & None
y: S
reveal_type(y)  # N: Revealed type is "Intersection[builtins.list[builtins.int], builtins.str, None]"
U = str & None
z: U
reveal_type(z)  # N: Revealed type is "Intersection[builtins.str, None]"

def f(): pass

X = int & str & f()
b: X  # E: Variable "__main__.X" is not valid as a type \
    # N: See https://mypy.readthedocs.io/en/stable/common_issues.html#variables-vs-type-aliases
[builtins fixtures/type.pyi]

[case testIntersectionAndSyntaxWithinRuntimeContextNotAllowed]
# flags: --python-version 3.9
from __future__ import annotations
from typing import List
T = int & str  # E: Invalid type alias: expression is not a valid type \
               # E: Unsupported left operand type for & ("Type[int]")
class C(List[int & str]):  # E: Type expected within [...] \
                           # E: Invalid base class "List"
    pass
C()
[builtins fixtures/tuple.pyi]

[case testIntersectionAndSyntaxWithinRuntimeContextNotAllowed2]
# flags: --python-version 3.9
from __future__ import annotations
from typing import cast
cast(str & int, 'x')  # E: Cast target is not a type
[builtins fixtures/tuple.pyi]
[typing fixtures/typing-full.pyi]

