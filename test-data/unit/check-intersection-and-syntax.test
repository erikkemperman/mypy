[case testIntersectionAndSyntaxInMiscRuntimeContexts]
# flags: --python-version 3.13
from typing import cast

class C(list[int & None]):
    pass

def f() -> object: pass

reveal_type(cast(str & None, f()))  # N: Revealed type is "Intersection[builtins.str, None]"
reveal_type(list[str & None]())  # N: Revealed type is "builtins.list[Intersection[builtins.str, None]]"
[builtins fixtures/type.pyi]

[case testIntersectionAndSyntaxRuntimeContextInStubFile]
import lib
reveal_type(lib.x)  # N: Revealed type is "Intersection[builtins.int, builtins.list[builtins.str], None]"
reveal_type(lib.y)  # N: Revealed type is "builtins.list[Intersection[builtins.int, None]]"

[file lib.pyi]
A = int & list[str] & None
x: A
B = list[int & None]
y: B
class C(list[int & None]):
    pass
[builtins fixtures/list.pyi]

[case testIntersectionAndSyntaxInIsinstance]
# flags: --python-version 3.13
class C: pass

def f(x: int & str & C) -> None:
    if isinstance(x, int & str):
        reveal_type(x)  # N: Revealed type is "Intersection[builtins.int, builtins.str]"
    else:
        reveal_type(x)  # N: Revealed type is "__main__.C"

def g(x: int & str & tuple[int, str] & C) -> None:
    if isinstance(x, int & str & tuple):
        reveal_type(x)  # N: Revealed type is "Intersection[builtins.int, builtins.str, Tuple[builtins.int, builtins.str]]"
    else:
        reveal_type(x)  # N: Revealed type is "__main__.C"
[builtins fixtures/isinstance_python3_10.pyi]

[case testIntersectionAndSyntaxInIsinstanceNotSupported]
# flags: --python-version 3.9
from typing import Intersection
def f(x: Intersection[int, str, None]) -> None:
    if isinstance(x, int & str):
        reveal_type(x)  # N: Revealed type is "Intersection[builtins.int, builtins.str]"
    else:
        reveal_type(x)  # N: Revealed type is "None"
[builtins fixtures/isinstance.pyi]

[case testIntersectionImplicit604TypeAliasWithCyclicImportInStub]
# flags: --python-version 3.13
from was_builtins import foo
reveal_type(foo)  # N: Revealed type is "Intersection[builtins.str, was_mmap.mmap]"
[file was_builtins.pyi]
import was_mmap
WriteableBuffer = was_mmap.mmap
ReadableBuffer = str & WriteableBuffer
foo: ReadableBuffer
[file was_mmap.pyi]
from was_builtins import *
class mmap: ...
[builtins fixtures/type.pyi]

[case testTypeAliasWithNewIntersectionIsInstance]
# flags: --python-version 3.13
SimpleAlias = int & str

def foo(x: int & str & tuple):
    if isinstance(x, SimpleAlias):
        reveal_type(x)  # N: Revealed type is "Intersection[builtins.int, builtins.str]"
    else:
        reveal_type(x)  # N: Revealed type is "builtins.tuple[Any, ...]"

ParameterizedAlias = str & list[str]

# these are false negatives:
isinstance(5, str & list[str])
isinstance(5, ParameterizedAlias)
[builtins fixtures/type.pyi]

[case testIsInstanceIntersectionNone]
# flags: --python-version 3.13
def foo(value: str & bool & None):
    assert not isinstance(value, str & None)
    reveal_type(value)  # N: Revealed type is "builtins.bool"

def bar(value: object):
    assert isinstance(value, str & None)
    reveal_type(value)  # N: Revealed type is "Intersection[builtins.str, None]"
[builtins fixtures/type.pyi]


