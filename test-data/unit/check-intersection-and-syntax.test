-- Type checking of intersection types with '&' syntax
-- TODO add --python-version 3.XY hopefully sometime

[case testIntersectionAndSyntaxWithTwoBuiltinsTypes]
# flags: --python-version 3.13
from __future__ import annotations
def f(x: int & str) -> int & str:
    reveal_type(x)  # N: Revealed type is "Intersection[builtins.int, builtins.str]"
    z: int & str = 0
    reveal_type(z)  # N: Revealed type is "Intersection[builtins.int, builtins.str]"
    return x
reveal_type(f)  # N: Revealed type is "def (x: Intersection[builtins.int, builtins.str]) -> Intersection[builtins.int, builtins.str]"
[builtins fixtures/tuple.pyi]

[case testIntersectionAndSyntaxWithThreeBuiltinsTypes]
# flags: --python-version 3.13
def f(x: int & str & float) -> int & str & float:
    reveal_type(x)  # N: Revealed type is "Intersection[builtins.int, builtins.str, builtins.float]"
    z: int & str & float = 0
    reveal_type(z)  # N: Revealed type is "Intersection[builtins.int, builtins.str, builtins.float]"
    return x
reveal_type(f)  # N: Revealed type is "def (x: Intersection[builtins.int, builtins.str, builtins.float]) -> Intersection[builtins.int, builtins.str, builtins.float]"

[case testIntersectionAndSyntaxWithTwoTypes]
# flags: --python-version 3.13
class A: pass
class B: pass
def f(x: A & B) -> A & B:
    reveal_type(x)  # N: Revealed type is "Intersection[__main__.A, __main__.B]"
    z: A & B = A()
    reveal_type(z)  # N: Revealed type is "Intersection[__main__.A, __main__.B]"
    return x
reveal_type(f)  # N: Revealed type is "def (x: Intersection[__main__.A, __main__.B]) -> Intersection[__main__.A, __main__.B]"

[case testIntersectionAndSyntaxWithThreeTypes]
# flags: --python-version 3.13
class A: pass
class B: pass
class C: pass
def f(x: A & B & C) -> A & B & C:
    reveal_type(x)  # N: Revealed type is "Intersection[__main__.A, __main__.B, __main__.C]"
    z: A & B & C = A()
    reveal_type(z)  # N: Revealed type is "Intersection[__main__.A, __main__.B, __main__.C]"
    return x
reveal_type(f)  # N: Revealed type is "def (x: Intersection[__main__.A, __main__.B, __main__.C]) -> Intersection[__main__.A, __main__.B, __main__.C]"

